{
  "name": "plug-funds",
  "private": true,
  "version": "0.1.7",
  "license": "MIT",
  "type": "module",
  "description": "个人投资工作站 · DeepSeek Harness 插件（本地优先）",
  "scripts": {
    "test": "node --test plugin/test/*.test.ts",
    "build": "node plugin/scripts/build.mjs",
    "check": "node plugin/scripts/build.mjs --check && node plugin/scripts/verify-web.mjs && node --test plugin/test/*.test.ts",
    "pack:dsh": "npm run build && node plugin/scripts/pack.mjs",
    "verify:install": "node plugin/scripts/verify-install.mjs",
    "verify:web": "node plugin/scripts/verify-web.mjs --browser",
    "backfill:metrics": "node plugin/scripts/backfill-metrics.mjs",
    "backfill:cnindex": "node plugin/scripts/backfill-cnindex.mjs",
    "backfill:history": "node plugin/scripts/backfill-index-history.mjs",
    "collect:reference": "node plugin/scripts/collect-index-reference.mjs",
    "backfill:reference": "node plugin/scripts/backfill-index-reference.mjs",
    "audit:metrics": "node plugin/scripts/audit-metrics.mjs",
    "import:indices": "node plugin/scripts/import-index-catalog.mjs",
    "refresh:indices": "node plugin/scripts/refresh-catalog.mjs",
    "fill:dates": "node plugin/scripts/fill-index-dates.mjs",
    "audit:indices": "node plugin/scripts/audit-index-data.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
